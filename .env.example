# /api/leads publishes each /contact submission to a Buzz channel.
# All four must be set in Vercel (Production + Preview) or the route answers 502
# and the lead only survives in the function logs.

# Buzz relay websocket endpoint.
BUZZ_RELAY_URL=wss://fikstudio.communities.buzz.xyz

# Channel that receives the leads. This is #leads (public).
BUZZ_LEADS_CHANNEL_ID=a4ea9dcb-8db9-4530-b3ff-b1143e8f723a

# Secret key the route signs with — nsec or 64 hex chars. Give this its own
# identity; whatever key goes here is what #leads shows as the sender.
BUZZ_LEADS_PRIVATE_KEY=

# NIP-42 delegation tag as a JSON array, e.g. ["auth","<owner-pubkey>","","<sig>"].
# The relay rejects the key above as "not a relay member" without it — it is sent
# both on the AUTH handshake and on the message itself.
BUZZ_LEADS_AUTH_TAG=
